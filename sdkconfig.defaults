# =============================================================================
# uext_screen —— 独立 USB 副屏固件默认配置（ESP32-S31-Korvo-1 / 16 MB flash）
#
# 基线：esp-iot-solution / usb_extend_screen 例程（sdkconfig.defaults +
#       sdkconfig.defaults.esp32s31），针对本板做过如下确定性调整：
#   - PSRAM 200 MHz（本板实测稳定档；例程默认 80 MHz）
#   - 独立分区表 partitions.csv（单 app 槽，无 OTA 双槽）
#   - 关闭 APP ROLLBACK（无 OTA 的专用固件不需要防砖回滚）
#   - 画质定稿：JPEG quality 9 + 单帧上限 450 KB
# =============================================================================

CONFIG_IDF_TARGET="esp32s31"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# ---- Flash ----
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- PSRAM ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=12768
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y

# ---- 控制台 ----
# 日志走 UART0（115200），同时保留 USB-Serial-JTAG 作为次级控制台。
# 注意：console 用的是独立的 USB-Serial-JTAG 外设，与下面 TinyUSB 占用的
# OTG HS PHY 不是同一个控制器，因此「插着 USB 副屏线」时依然能看串口日志。
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# ---- Boot ----
# 无 OTA 的专用固件：关闭 rollback，启动即定为有效镜像。
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE is not set

# ---- Compiler / RTOS ----
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_PERIPH_CTRL_FUNC_IN_IRAM=y

# ---- Codec (UAC 音频通路 / ES8389) ----
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n
CONFIG_CODEC_ES8389_SUPPORT=y

# ---- TinyUSB (HS PHY) ----
# VID 0x303A(乐鑫) / PID 0x2986(复合设备：显示 + 触摸 + 音频)。
# ★ Windows 驱动 INF 按 VID_303A&PID_2986 匹配，改这两个值会让驱动装不上。
CONFIG_TINYUSB_RHPORT_HS=y
CONFIG_TUSB_PRODUCT="udisp"

# ---- HID 触摸 (GT1151, 5 点) ----
CONFIG_HID_TOUCH_ENABLE=y
CONFIG_ESP_LCD_TOUCH_MAX_POINTS=5

# ---- UAC 音频 (48 kHz, 扬声器 + 麦克风) ----
CONFIG_UAC_AUDIO_ENABLE=y
CONFIG_USB_DEVICE_UAC_AS_PART=y
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_MIC_CHANNEL_NUM=2
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_SPK_INTERVAL_MS=10
CONFIG_UAC_MIC_INTERVAL_MS=10
CONFIG_UAC_SPK_NEW_PLAY_INTERVAL=100
CONFIG_UAC_SPK_TASK_PRIORITY=6
CONFIG_UAC_MIC_TASK_PRIORITY=6

# ---- 扩展屏 (800x480 @ 60fps, RGB565) ----
# 面板总线是 16-bit RGB565，没有 RGB888 通路；画质的真正旋钮是 JPEG 质量与
# 单帧上限。quality 9 + 450KB 是画质/带宽/帧率的实测平衡点。
CONFIG_USB_EXTEND_SCREEN_HEIGHT=800
CONFIG_USB_EXTEND_SCREEN_WIDTH=480
CONFIG_USB_EXTEND_SCREEN_MAX_FPS=60
CONFIG_USB_EXTEND_SCREEN_JPEG_QUALITY=9
CONFIG_USB_EXTEND_SCREEN_FRAME_LIMIT_B=450000
CONFIG_EXAMPLE_LCD_BUF_COUNT=2
CONFIG_LCD_PIXEL_FORMAT_RGB565=y
